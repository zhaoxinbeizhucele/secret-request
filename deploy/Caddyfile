{
    servers {
        timeouts {
            read_header 10s
            read_body 20s
            write 30s
            idle 30s
        }
    }
}
{$SECRET_REQUEST_DOMAIN} {
    request_body {
        max_size 100KB
    }
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy relay:8787 {
        header_up X-Forwarded-For {remote_host}
        transport http {
            dial_timeout 5s
            response_header_timeout 25s
        }
    }
}
