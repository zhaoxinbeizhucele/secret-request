# Existing HTTPS reverse proxy: adapt certificate paths before enabling.
# Keep request/capability URLs out of access logs.
server {
    listen 80;
    server_name secret-request.example.com;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name secret-request.example.com;
    ssl_certificate /etc/letsencrypt/live/secret-request.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/secret-request.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    client_max_body_size 100k;
    client_body_timeout 20s;
    client_header_timeout 10s;
    keepalive_timeout 30s;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 25s;
        proxy_send_timeout 25s;
        proxy_buffering off;
    }
}
