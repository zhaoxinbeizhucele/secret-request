{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secret-request-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "BASE_URL": "http://127.0.0.1:8787" },
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "Relay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }],
  "rules": [{ "type": "Text", "globs": ["**/web/*.html", "**/web/*.css", "**/web/*.js"], "fallthrough": true }],
  "observability": { "enabled": false },
  "send_metrics": false
}
